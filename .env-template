# .env-template — copy to .env and fill in what you need.
# None of these are required for the offline eval harness (echo agent, unit tests).

# ── LLM (required for all `fireworks*` agents) ─────────────────────────────
# Fireworks API key — https://fireworks.ai/account/api-keys
# Used by src/pmf_agent/fw.py to call accounts/fireworks/models/glm-5p3-flash
# via the OpenAI-compatible endpoint.
FIREWORKS_API_KEY=

# ── Decision routing (optional — Stage 2 middleware) ──────────────────────
# OpenAI Decisions API key for the ToolSelectionMiddleware (intent-routed
# tool filtering). WITHOUT it, the routed agent still works: every selection
# degrades to "keep all tools" (verified: zero flips vs unrouted).
# Accepts either key; DecisionsClient reads DECISIONS_API_KEY first.
#DECISIONS_API_KEY=
#OPENAI_API_KEY=

# ── Fixture replay (optional — eval harness) ──────────────────────────────
# Pin the "today" anchor for fixture date-shifting (ISO date). Defaults to
# today - 2 days. Set it to replay a run against the same window.
#PMF_FIXTURE_ANCHOR=2026-10-29

# ── Approval workflow (optional — Stage 4) ────────────────────────────────
# Root dir for the ProposalStore (pending proposals + mutation ledger).
# Defaults to ./workspace.
#PMF_STORE_DIR=workspace

# Comma-separated approver IDs (e.g. Slack user IDs). Alternative to
# workspace/approvers.txt. Fail-closed: if both are empty/missing, ALL
# approve attempts are refused.
#PMF_APPROVERS=U123,U777
